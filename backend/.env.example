# ORCA Marine Intelligence Platform - Environment Configuration

# Groq API Key for Llama-3.3 Reasoning Engine (Optional, deterministic fallback active)
GROQ_API_KEY=

# IMD (India Meteorological Department) API Key (Optional, coastal fallback active)
IMD_API_KEY=

# Weather API Key (Optional)
WEATHER_API_KEY=

# MOSDAC (ISRO Satellite Centre) Credentials (Optional)
MOSDAC_USERNAME=
MOSDAC_PASSWORD=

# SQLite Database Location
DATABASE_URL=sqlite:///./orca.db
